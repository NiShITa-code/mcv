# Run outputs. `destination:` defaults here, so without this rule a contributor's
# first real run stages several GB of their own artifacts for commit.
mcv_artifacts/
ckpt/
wandb/
outputs/
generation_runs/
*.eval

# Everything under results/ IS tracked on purpose: it is the evidence behind the
# numbers we report. Add new run outputs there deliberately, not by accident.

# OS
.DS_Store
Thumbs.db

# Built documentation site (mkdocs build). The sources are mcv/docs/.
site/

# Vector output and model checkpoints. Upstream writes vectors to persona_vectors/
# and mcv's configs point at that path. A checkpoint with embeddings saved is ~7.7GB.
persona_vectors/
train_runs/
pipeline_runs/

# The upstream overlay. CI copies persona_vectors' eval/ and its root modules into
# the checkout, because mcv/tests/_paths.py looks for them beside the package: that
# is what makes the integration tests run instead of skip. Reproduce it locally and
# these files land at the repo root, untracked and not obviously upstream's.
#
# mcv's architecture rule is that no upstream source lives in this repo. One
# `git add -A` after a local CI-equivalent run would break it silently, so ignore
# them. The repo has no root-level .py files of its own; every name here is
# upstream's at b8e0f04. Add to the list if upstream grows another.
/eval/
/activation_steer.py
/config.py
/generate_vec.py
/judge.py
/sft.py
/training.py
/utils.py
/validate.py
